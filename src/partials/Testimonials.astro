---
import TestimonialsCard from '../components/testimonials_card.astro';
import TestimonialsLightbox from '../components/testimonials_lightbox.astro';

const letters = [
  {
    image: '/assets/images/testimonials/20250528_180311.jpg',
    logo: '/assets/images/logos/padyabtajhiz.avif',
    title: 'پادیاب تجهیز',

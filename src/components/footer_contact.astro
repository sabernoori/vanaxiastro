---

{
  items.map((item) => (
    <div class="footer_contact" style={item.compactOrder ? `--footer-contact-order: ${item.compactOrder}` : undefined}>
      <div>
        <a href={item.href} class="text-small opacity-60">
          {item.label}
        </a>
      </div>
      <a href={item.href} class="footer_contact-item" aria-label={item.ariaLabel}>
        <div class="icon-24 is-gray">
          <svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 24 24" fill="none">
            <path d={icons[item.icon]} fill="currentColor" />
          </svg>
        </div>
      </a>
    </div>
  ))
}

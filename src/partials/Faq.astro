---
import FaqItem from '../components/faq_item.astro';

const intro = 'ما به برخی سوالات رایج شما پاسخ داده ایم. درصورتی که پاسخی برای سوال خود پیدا نکردید میتوانید با ما درتماس باشید.';
const contact = { href: '#process', label: 'تماس با ما' };

const faqs = [
  {
    question: 'ونکسی چه خدماتی ارائه می‌دهد؟',
    answer: 'ونکسی خدمات حمل‌ونقل سازمانی شامل سرویس پرسنل، سفر در اختیار، ترانسفر فرودگاهی و سفرهای بین‌شهری را با ناوگان باکیفیت و رانندگان آموزش‌دیده ارائه می‌کند.',
  },
  {
    question: 'سرویس پرسنل چگونه کار می‌کند؟',
    answer: 'پس از مشاوره رایگان، مسیرها و شیفت‌های کارکنان شما طراحی می‌شود و سرویس به‌صورت منظم طبق برنامه سازمانی اجرا و پایش می‌گردد تا زمان رسیدن و هزینه شفاف بماند.',
  },
  {
    question: 'آیا ترانسفر فرودگاهی و سفر بین‌شهری دارید؟',
    answer: 'بله. ونکسی ترانسفر فرودگاهی برای مهمانان و مدیران سازمان و همچنین سفرهای بین‌شهری برنامه‌ریزی‌شده را با هماهنگی زمان پرواز یا جلسه شما پوشش می‌دهد.',
  },
  {
    question: 'هزینه خدمات چگونه محاسبه می‌شود؟',
    answer: 'هزینه بر اساس نوع سرویس، تعداد مسیرها، حجم تردد و سطح ناوگان محاسبه می‌شود. هدف ونکسی ارائه مدل شفاف و قابل پیش‌بینی برای بودجه‌بندی سازمانی است.',
  },
  {
    question: 'چطور می‌توانم مشاوره رایگان بگیرم؟',
    answer: 'از طریق دکمه «مشاوره رایگان» یا «تماس با ما» در سایت درخواست خود را ثبت کنید تا تیم ونکسی نیازهای سازمان شما را بررسی و بهترین سرویس را پیشنهاد دهد.',
  },
];
---
<section id="faq" aria-label="سوالات متداول" class="section_faq">
  <div class="max-width">
    <div class="faq_box">
      <div class="faq_heading-wrapper">
        <h2 class="heading-section">سوالات متداول</h2>
        <p data-kashida class="opacity-50">{intro}</p>
        <a href={contact.href} class="button w-button">{contact.label}</a>
      </div>
      <div class="faq_list" itemscope itemtype="https://schema.org/FAQPage">
        {faqs.map((item) => <FaqItem question={item.question} answer={item.answer} />)}
      </div>
    </div>
  </div>
</section>

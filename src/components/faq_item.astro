---
interface Props {
  question: string;
  answer: string;
}

const { question, answer } = Astro.props;
---

<div itemprop="mainEntity" itemscope itemtype="https://schema.org/Question" class="faq_item">
  <div class="faq-spacer-1-5rem"></div>
  <div>
    <div class="faq_question-group">
      <div class="icon-24 is-gray" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 24 24" fill="none">
          <path d="M6 11.75H18C18.1339 11.75 18.25 11.8661 18.25 12C18.25 12.1339 18.1339 12.25 18 12.25H6C5.86614 12.25 5.75 12.1339 5.75 12C5.75 11.8661 5.86614 11.75 6 11.75Z" fill="currentColor" stroke="currentColor"></path>
          <path d="M12 5.75C12.1339 5.75 12.25 5.86614 12.25 6V18C12.25 18.1339 12.1339 18.25 12 18.25C11.8661 18.25 11.75 18.1339 11.75 18V6C11.75 5.86614 11.8661 5.75 12 5.75Z" fill="currentColor" stroke="currentColor"></path>
        </svg>
      </div>
      <p itemprop="name" class="faq_question-text">{question}</p>
    </div>
  </div>
  <div itemscope itemtype="https://schema.org/Answer" itemprop="acceptedAnswer" class="faq_answer is-hide">
    <div class="faq-spacer-1-25rem"></div>
    <p data-kashida itemprop="text">{answer}</p>
  </div>
  <div class="faq-spacer-1-5rem"></div>
</div>

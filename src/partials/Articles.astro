---
import BlogCard from '../components/blog_card.astro';
import SectionHead from '../components/section_head.astro';

const head = {
  title: 'تازه‌ها و خواندنی‌ها',
  titleId: 'articles-title',
  linkHref: '/journal',
  linkLabel: 'همه اخبار و مقالات',
};

const posts = [
  {
    image: '/assets/images/blog/blog11.avif',
    imageAlt: 'خودروهای حاضر در رویداد بابلسر با خدمات‌رسانی ونکسی',
    date: '۱۴۰۵/۶/۲۱',
    category: 'خبر',
    title: 'از سراسر ایران به بابلسر؛ خدمات حمل‌ونقل ونکسی برای رویداد سازمانی با حضور بیش از ۷۰ پزشک',
    excerpt: 'ونکسی با ارائه خدمات حمل‌ونقل به شرکت‌های دارویی، در برگزاری رویدادی با حضور بیش از 7۰ پزشک در بابلسر مشارکت داشت. حضور خودروها از سراسر کشور، هماهنگی سفرها و اقدام فوری برای پاسخ‌گویی به نیازهای اجرایی، محور خدمات ونکسی در این رویداد بود.',
    href: '/journal/ونکسی-دربستی-بابلسر'
  }
];
---

<section class="section_articles" aria-labelledby="articles-title">
  <div class="max-width">
    <div class="logos_flex">
      <SectionHead title={head.title} titleId={head.titleId} linkHref={head.linkHref} linkLabel={head.linkLabel}>
      <div class="cms-cards">
        {posts.map((post) => (
          <BlogCard
            image={post.image}
            imageAlt={post.imageAlt}
            date={post.date}
            category={post.category}
            title={post.title}
            excerpt={post.excerpt}
            href={post.href}
          />
        ))}
      </div>
      </SectionHead>
      <div class="hide"></div>
    </div>
  </div>
</section>

<style>
  .section_articles {
    display: flex;
    padding-top: 1rem;
    padding-bottom: 3.5rem;
    flex-direction: column;
    justify-content: flex-start;
    flex-wrap: nowrap;
    align-items: center;
    background-image: url("/assets/images/6a6babfe2fcaf283b0232a2a_client-logo-bg.avif");
    background-position: 50% 0%;
    background-size: cover;
  }

  .cms-cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px;
    width: 100%;
  }

  @media screen and (max-width: 991px) {
    .section_articles {
      padding-top: 1.25rem;
    }
  }

  @media screen and (max-width: 900px) {
    .cms-cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 767px) {
    .section_articles {
      padding-bottom: 1.25rem;
    }
  }

  @media screen and (max-width: 600px) {
    .cms-cards {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>

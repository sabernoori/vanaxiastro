---
import BlogCard from '../components/blog_card.astro';

const posts = [
  {
    image: '/assets/images/blog/blog11.avif',
    imageAlt: 'خودروهای حاضر در رویداد بابلسر با خدمات‌رسانی ونکسی',
    date: '۱۴۰۵/۶/۲۱',
    category: 'خبر',
    title: 'از سراسر ایران به بابلسر؛ خدمات حمل‌ونقل ونکسی برای رویداد سازمانی با حضور بیش از ۷۰ پزشک',
    excerpt: 'ونکسی با ارائه خدمات حمل‌ونقل به شرکت‌های دارویی، در برگزاری رویدادی با حضور بیش از 7۰ پزشک در بابلسر مشارکت داشت. حضور خودروها از سراسر کشور، هماهنگی سفرها و اقدام فوری برای پاسخ‌گویی به نیازهای اجرایی، محور خدمات ونکسی در این رویداد بود.',
    href: '/journal/ونکسی-دربستی-بابلسر'
  }
];
---

<section class="section_articles" aria-labelledby="articles-title">
  <div class="max-width">
    <div class="logos_flex">
      <div class="logos_head-wrapper">
        <a href="/journal" class="text-link-wrapper show-dt w-inline-block">
          <div class="icon-24">
            <svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 24 24" fill="none">
              <path d="M9.57043 18.8201C9.38043 18.8201 9.19043 18.7501 9.04043 18.6001L2.97043 12.5301C2.68043 12.2401 2.68043 11.7601 2.97043 11.4701L9.04043 5.40012C9.33043 5.11012 9.81043 5.11012 10.1004 5.40012C10.3904 5.69012 10.3904 6.17012 10.1004 6.46012L4.56043 12.0001L10.1004 17.5401C10.3904 17.8301 10.3904 18.3101 10.1004 18.6001C9.96043 18.7501 9.76043 18.8201 9.57043 18.8201Z" fill="currentColor"></path>
              <path d="M20.4999 12.75H3.66992C3.25992 12.75 2.91992 12.41 2.91992 12C2.91992 11.59 3.25992 11.25 3.66992 11.25H20.4999C20.9099 11.25 21.2499 11.59 21.2499 12C21.2499 12.41 20.9099 12.75 20.4999 12.75Z" fill="currentColor"></path>
            </svg>
          </div>
          <div>همه اخبار و مقالات</div>
        </a>
        <h2 id="articles-title" class="logos_heading h5">تازه‌ها و خواندنی‌ها</h2>
      </div>
      <div class="cms-cards">
        {posts.map((post) => (
          <BlogCard
            image={post.image}
            imageAlt={post.imageAlt}
            date={post.date}
            category={post.category}
            title={post.title}
            excerpt={post.excerpt}
            href={post.href}
          />
        ))}
      </div>
      <div class="logos_head-wrapper is-bottom">
        <a href="/journal" class="text-link-wrapper w-inline-block">
          <div class="icon-24">
            <svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 24 24" fill="none">
              <path d="M9.57043 18.8201C9.38043 18.8201 9.19043 18.7501 9.04043 18.6001L2.97043 12.5301C2.68043 12.2401 2.68043 11.7601 2.97043 11.4701L9.04043 5.40012C9.33043 5.11012 9.81043 5.11012 10.1004 5.40012C10.3904 5.69012 10.3904 6.17012 10.1004 6.46012L4.56043 12.0001L10.1004 17.5401C10.3904 17.8301 10.3904 18.3101 10.1004 18.6001C9.96043 18.7501 9.76043 18.8201 9.57043 18.8201Z" fill="currentColor"></path>
              <path d="M20.4999 12.75H3.66992C3.25992 12.75 2.91992 12.41 2.91992 12C2.91992 11.59 3.25992 11.25 3.66992 11.25H20.4999C20.9099 11.25 21.2499 11.59 21.2499 12C21.2499 12.41 20.9099 12.75 20.4999 12.75Z" fill="currentColor"></path>
            </svg>
          </div>
          <div>همه اخبار و مقالات</div>
        </a>
        <h2 class="logos_heading h5 show-dt" aria-hidden="true">تازه‌ها و خواندنی‌ها</h2>
      </div>
      <div class="hide"></div>
    </div>
  </div>
</section>

<style>
  .section_articles {
    display: flex;
    padding-top: 1rem;
    padding-bottom: 3.5rem;
    flex-direction: column;
    justify-content: flex-start;
    flex-wrap: nowrap;
    align-items: center;
    background-image: url("/assets/images/6a6babfe2fcaf283b0232a2a_client-logo-bg.avif");
    background-position: 50% 0%;
    background-size: cover;
  }

  .cms-cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px;
    width: 100%;
  }

  @media screen and (max-width: 991px) {
    .section_articles {
      padding-top: 1.25rem;
    }
  }

  @media screen and (max-width: 900px) {
    .cms-cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 767px) {
    .section_articles {
      padding-bottom: 1.25rem;
    }
  }

  @media screen and (max-width: 600px) {
    .cms-cards {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>

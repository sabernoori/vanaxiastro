---
export interface FooterContactItem {
  label: string;
  href: string;
  ariaLabel: string;
  icon: 'pin' | 'mail' | 'phone';
  /** ترتیب در تبلت و موبایل. دسکتاپ ترتیب خود آرایه را نگه می‌دارد. */
  compactOrder?: number;
}

interface Props {
  items: FooterContactItem[];
}


---
import SectionHead from '../components/section_head.astro';
import LogoItem from '../components/logo_item.astro';

const head = {
  title: 'برخی شرکت هایی که به ما اعتماد کرده اند',
  linkHref: '#stories',
  linkLabel: 'مزایای ونکسی را از زبان مشتریان ما بشنوید',
};

const logos = [
  { src: '/assets/images/logos/05%20-%20electronic%20pishrafte.avif', alt: 'الکترونیک پیشرفته پزشکی', width: 168, height: 36, pairSrc: '/assets/images/logos/16.avif', pairAlt: 'مهرسان نوین پارس', pairWidth: 101, pairHeight: 40 },
  { src: '/assets/images/logos/04%20-shafayab.avif', alt: 'Shafayab Gostar', width: 135, height: 40 },
  { src: '/assets/images/logos/03%20-%20actoverco.avif', alt: 'Actoverco', width: 164, height: 40, pairSrc: '/assets/images/logos/17.avif', pairAlt: 'Noya Vision', pairWidth: 173, pairHeight: 40 },
  { src: '/assets/images/logos/02%20-nestle.avif', alt: 'Nestlé', width: 39, height: 40 },
  { src: '/assets/images/logos/01couble%20darou.avif', alt: 'Cobel Darou', width: 126, height: 40 },
  { src: '/assets/images/logos/9.avif', alt: 'هما فارمد', width: 109, height: 40, pairSrc: '/assets/images/logos/18.avif', pairAlt: 'Erica Pharmed Pars', pairWidth: 145, pairHeight: 40 },
  { src: '/assets/images/logos/9-behestan%20daroo.avif', alt: 'بهستان دارو', width: 126, height: 40 },
  { src: '/assets/images/logos/8.avif', alt: 'tekaje', width: 143, height: 40 },
  { src: '/assets/images/logos/7.avif', alt: 'Adrian', width: 155, height: 40 },
  { src: '/assets/images/logos/06.%20tehran%20shimi.avif', alt: 'تهران شیمی', width: 80, height: 40, pairSrc: '/assets/images/logos/19.avif', pairAlt: 'توربو کمپرسور نفت', pairWidth: 142, pairHeight: 40 },
  { src: '/assets/images/logos/15.avif', alt: 'پتروشیمی کرمانشاه', width: 190, height: 38 },
  { src: '/assets/images/logos/14.avif', alt: 'بهستان پلاسما', width: 120, height: 40 },
  { src: '/assets/images/logos/13.avif', alt: 'درمان یاب', width: 170, height: 40, pairSrc: '/assets/images/logos/20.avif', pairAlt: 'ترانس پست پارس', pairWidth: 160, pairHeight: 40 },
  { src: '/assets/images/logos/12.avif', alt: 'آتی فارمد', width: 128, height: 40 },
  { src: '/assets/images/logos/11.avif', alt: 'سانافارمد', width: 144, height: 40, pairSrc: '/assets/images/logos/21.avif', pairAlt: 'انرژی گستر نصیر', pairWidth: 130, pairHeight: 40 },
];
---
<section id="clients" aria-label="مشتریان ونکسی" class="section_logos" data-scroll-speed="40%">
  <div class="max-width">
    <div class="logos_flex">
      <SectionHead title={head.title} linkHref={head.linkHref} linkLabel={head.linkLabel}>
        <div class="logos_grid">
          {logos.map((logo) => <LogoItem {...logo} />)}
        </div>
      </SectionHead>
      <div class="hide"></div>
    </div>
  </div>
</section>

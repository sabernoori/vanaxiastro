---
import Layout from '../layouts/Layout.astro';
import Navbar from '../partials/Navbar.astro';
import Footer from '../partials/Footer.astro';
import Hero from '../partials/Hero.astro';
import Video from '../partials/Video.astro';
import Why from '../partials/Why.astro';
import Logos from '../partials/Logos.astro';
import Services from '../partials/Services.astro';
import Pharma from '../partials/Pharma.astro';
import Process from '../partials/Process.astro';
import Story from '../partials/Story.astro';
import Faq from '../partials/Faq.astro';
import Seo from '../partials/Seo.astro';
---

<Layout>
  <div class="page-wrapper">
    <Navbar />
    <main id="main-content" class="main-wrapper">
      <Hero />
      <Video />
      <Why />
      <Logos />
      <Services />
      <Pharma />
      <Process />
      <Story />
      <Faq />
      <Seo />
    </main>
    <Footer />
  </div>
</Layout>

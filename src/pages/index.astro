---
import Layout from '../layouts/Layout.astro';
import Navbar from '../partials/Navbar.astro';
import Footer from '../partials/Footer.astro';
import Hero from '../partials/hero.html';
import Video from '../partials/video.html';
import Why from '../partials/why.html';
import Logos from '../partials/logos.html';
import Services from '../partials/services.html';
import Pharma from '../partials/pharma.html';
import Process from '../partials/process.html';
import Story from '../partials/story.html';
import Faq from '../partials/faq.html';
import Seo from '../partials/seo.html';
---

<Layout>
  <div class="page-wrapper">
    <Navbar />
    <main id="main-content" class="main-wrapper">
      <Hero />
      <Video />
      <Why />
      <Logos />
      <Services />
      <Pharma />
      <Process />
      <Story />
      <Faq />
      <Seo />
    </main>
    <Footer />
  </div>
</Layout>

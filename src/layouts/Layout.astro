---
import jsonLd from '../data/json-ld.json';
import '../styles/critical.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'ونکسی | حمل و نقل سازمانی هوشمند',
  description = 'ونکسی ارائه‌دهنده خدمات حمل‌ونقل سازمانی، سرویس پرسنل، ترانسفر فرودگاهی و سفرهای بین‌شهری با ناوگان باکیفیت، رانندگان آموزش‌دیده و مدیریت هزینه شفاف برای سازمان‌ها.'
} = Astro.props;

const site = Astro.site ?? new URL('https://vanaxi.com');
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL('/assets/images/6a6ba3019788fb2728d17441_Prestige.png', site).href;
const ogDescription =
  'شریک استراتژیک سازمان‌ها در حمل‌ونقل سازمانی؛ سرویس پرسنل، ترانسفر و سفرهای بین‌شهری با تجربه بهتر و هزینه شفاف.';
---

<!doctype html>
<html
  lang="fa"
  data-wf-site="6a6a13f0268d0805f764d78f"
  data-wf-page="6a6a13f2268d0805f764d7d6"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="author" content="ونکسی" />
    <meta name="theme-color" content="#000b22" />
    <meta name="color-scheme" content="light" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="fa" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM information" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ونکسی" />
    <meta property="og:locale" content="fa_IR" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="خدمات حمل‌ونقل سازمانی ونکسی" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="خدمات حمل‌ونقل سازمانی ونکسی" />

    <link rel="icon" type="image/png" sizes="32x32" href="/assets/images/6a6a5a73492882b59de69687_fav-icon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/images/6a6a5a73492882b59de69692_fav-icon.png" />

    <link
      rel="preload"
      href="/assets/fonts/Ravi-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/assets/fonts/Ravi-SemiBold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <link
      rel="preload"
      href="/assets/images/6a6a5aff998615e9c54b0be7_hero-bg.avif"
      as="image"
      type="image/avif"
      fetchpriority="high"
    />
    <link
      rel="preload"
      href="/assets/images/6a6b3faccd46c45ce795f994_hero-img.avif"
      as="image"
      type="image/avif"
      fetchpriority="high"
    />
    <link
      rel="preload"
      as="image"
      type="image/png"
      href="/assets/images/6a6e0ea67dfa6f1e08cfdd43_footer-img.png"
      imagesrcset="/assets/images/6a6e0ea67dfa6f1e08cfdd43_footer-img-p-500.png 500w, /assets/images/6a6e0ea67dfa6f1e08cfdd43_footer-img-p-800.png 800w, /assets/images/6a6e0ea67dfa6f1e08cfdd43_footer-img-p-1080.png 1080w, /assets/images/6a6e0ea67dfa6f1e08cfdd43_footer-img-p-1600.png 1600w, /assets/images/6a6e0ea67dfa6f1e08cfdd43_footer-img-p-2000.png 2000w, /assets/images/6a6e0ea67dfa6f1e08cfdd43_footer-img.png 2012w"
      imagesizes="(max-width: 2012px) 100vw, 2012px"
      fetchpriority="low"
    />

    <link rel="preload" href="/styles/webflow.css" as="style" />
    <link rel="stylesheet" href="/styles/webflow.css" media="print" onload="this.media='all'" />
    <link rel="stylesheet" href="/styles/custom.css" media="print" onload="this.media='all'" />
    <noscript>
      <link rel="stylesheet" href="/styles/webflow.css" />
      <link rel="stylesheet" href="/styles/custom.css" />
    </noscript>

    <style is:inline>
      html.w-mod-js:not(.w-mod-ix3) :is(.why_img) { visibility: hidden !important; }
      html { scroll-behavior: auto; }
      html.w-mod-js:not(.services-cover-ready) .section_services.is-services-cover .heading-section-scale {
        transform: scale(3);
        transform-origin: 50% 50%;
      }
      html.w-mod-js:not(.services-cover-ready) .section_services.is-services-cover .services_scale {
        transform: scale(0.8);
        transform-origin: 50% 50%;
      }
      @media (prefers-reduced-motion: reduce) {
        html.w-mod-js:not(.services-cover-ready) .section_services.is-services-cover .heading-section-scale,
        html.w-mod-js:not(.services-cover-ready) .section_services.is-services-cover .services_scale {
          transform: none;
        }
      }
    </style>
    <script is:inline>
      !function(o,c){var n=c.documentElement,t=" w-mod-";n.className+=t+"js",("ontouchstart"in o||o.DocumentTouch&&c instanceof DocumentTouch)&&(n.className+=t+"touch")}(window,document);
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">پرش به محتوای اصلی</a>
    <slot />
    <script is:inline defer src="/vendor/jquery.js"></script>
    <script is:inline defer src="/vendor/webflow.schunk.1.js"></script>
    <script is:inline defer src="/vendor/webflow.schunk.2.js"></script>
    <script is:inline defer src="/vendor/webflow.main.js"></script>
    <script is:inline defer src="/vendor/gsap.min.js"></script>
    <script is:inline defer src="/vendor/ScrollTrigger.min.js"></script>
    <script is:inline defer src="/vendor/lenis.min.js"></script>
    <script is:inline defer src="/js/script.js"></script>
    <script is:inline defer src="/js/gsap.js"></script>
    <script is:inline defer src="/js/why-daylight.js"></script>
    <script is:inline defer src="/js/kashida.js"></script>
  </body>
</html>
